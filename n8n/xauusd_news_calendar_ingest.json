{
  "id": "xauusdNewsCalendarIngest01",
  "name": "XAUUSD News Calendar Ingest",
  "description": "SPEC.md §4.7: pull ForexFactory thisweek XML every 6 hours and upsert into news_events. Separate from the 5-minute per-module pipeline — news has its own cadence.",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "node-news-sched-001",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://172.18.0.1:8000/news/calendar/ingest",
        "options": { "timeout": 30000 }
      },
      "id": "node-news-ingest-001",
      "name": "news/calendar/ingest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "continueOnFail": true,
      "position": [-100, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-news-error-001",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-news-if-001",
      "name": "Error?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [160, 0]
    },
    {
      "parameters": {
        "chatId": "-1003415771278",
        "text": "⚠️ News calendar ingest failed\nError: {{ $json.error ?? $json.message ?? 'unknown' }}\nTime (Tehran): {{ $now.setZone('Asia/Tehran').toFormat('yyyy-MM-dd HH:mm') }}",
        "additionalFields": {}
      },
      "id": "node-news-alert-001",
      "name": "Alert on failure",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [420, -120],
      "credentials": {
        "telegramApi": {
          "id": "xauusdBotTelegramCred01",
          "name": "XAUUSD Bot Telegram"
        }
      }
    }
  ],
  "connections": {
    "Every 6 hours": {
      "main": [[{ "node": "news/calendar/ingest", "type": "main", "index": 0 }]]
    },
    "news/calendar/ingest": {
      "main": [[{ "node": "Error?", "type": "main", "index": 0 }]]
    },
    "Error?": {
      "main": [
        [{ "node": "Alert on failure", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": null,
  "nodeGroups": [],
  "pinData": null,
  "tags": []
}
