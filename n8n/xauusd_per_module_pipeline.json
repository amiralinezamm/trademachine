        "text": "={{ $json.signal.direction === 'BUY' ? '\ud83d\udfe2' : '\ud83d\udd34' }} XAUUSD@ | {{ $json.signal.direction === 'BUY' ? '\u062e\u0631\u06cc\u062f (BUY)' : '\u0641\u0631\u0648\u0634 (SELL)' }}\n\u0642\u06cc\u0645\u062a \u0648\u0631\u0648\u062f: {{ $json.signal.entry.toFixed(3) }}\nSL \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u06cc: {{ ($json.signal.direction === 'BUY' ? ($json.signal.entry - 2 * $json.signal.components.atr) : ($json.signal.entry + 2 * $json.signal.components.atr)).toFixed(3) }} (\u22122\u00d7ATR)\nTP \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u06cc: {{ ($json.signal.direction === 'BUY' ? ($json.signal.entry + 3 * $json.signal.components.atr) : ($json.signal.entry - 3 * $json.signal.components.atr)).toFixed(3) }} (+3\u00d7ATR)\n\u0633\u0637\u062d \u0628\u0631\u062e\u0648\u0631\u062f\u06cc: {{ $json.signal.components.level_kind === 'support' ? '\u062d\u0645\u0627\u06cc\u062a' : '\u0645\u0642\u0627\u0648\u0645\u062a' }} [{{ $json.signal.components.level_price_low }} - {{ $json.signal.components.level_price_high }}]\n\u0642\u062f\u0631\u062a \u0633\u0637\u062d: {{ $json.signal.components.level_strength.toFixed(3) }}\n\u0641\u0627\u0635\u0644\u0647 \u062a\u0627 \u0633\u0637\u062d: {{ $json.signal.components.distance.toFixed(3) }} (ATR={{ $json.signal.components.atr.toFixed(3) }})\n\u0642\u0627\u0646\u0648\u0646: {{ $json.signal.rule_version }} (status=testing\u060c \u0628\u06a9\u200c\u062a\u0633\u062a \u0646\u0634\u062f\u0647)\n\u0632\u0645\u0627\u0646 (\u062a\u0647\u0631\u0627\u0646): {{ $json.signal.ts_utc.toDateTime().setZone('Asia/Tehran').toFormat('yyyy-MM-dd HH:mm') }}",
